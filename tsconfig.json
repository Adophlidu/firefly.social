{
    "extends": "@masknet/config",
    "compilerOptions": {
        "types": [],
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "stories/**/*.ts",
        "stories/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "globals.d.ts",
        "next-auth.d.ts",
        ".next/types/**/*.ts"
    ],
    "exclude": ["node_modules", "src/service-workers"]
}
