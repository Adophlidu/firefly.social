{
    "extends": "@masknet/config",
    "compilerOptions": {
        "types": [],
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
        "paths": {
            "@/*": ["./src/*"],
            "next/navigation.js": ["./src/esm/navigation.ts"],
            "@masknet/base": ["./src/mask_pkgs/base/index.ts"],
            "@masknet/web3-hooks-base": ["./src/mask_pkgs/web3-hooks/base/index.ts"],
            "@masknet/web3-shared-base": ["./src/mask_pkgs/web3-shared/base/index.ts"],
            "@masknet/web3-shared-evm": ["./src/mask_pkgs/web3-shared/evm/index.ts"],
            "@masknet/web3-shared-solana": ["./src/mask_pkgs/web3-shared/solana/index.ts"],
            "@masknet/web3-constants/*": ["./src/mask_pkgs/web3-constants/*"],
            "@masknet/web3-contracts/*": ["./src/mask_pkgs/web3-contracts/*"],
            "@masknet/web3-helpers": ["./src/mask_pkgs/web3-helpers/index.ts"],
            "@masknet/web3-providers": ["./src/mask_pkgs/web3-providers/entry.ts"],
            "@masknet/web3-providers/types": ["./src/mask_pkgs/web3-providers/entry-types.ts"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "csp.js", "globals.d.ts", "next-auth.d.ts", ".next/types/**/*.ts"],
    "exclude": ["node_modules", "src/service-workers"]
}
