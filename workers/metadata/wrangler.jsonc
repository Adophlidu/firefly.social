{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "firefly-metadata",
    "main": "./src/index.ts",
    "compatibility_flags": ["nodejs_compat_v2"],
    "compatibility_date": "2024-09-23",
    "kv_namespaces": [
        {
            "binding": "METADATA_CACHE",
            "id": "e8866b94511d4ce188164437cf8ae5fb",
        },
    ],
    "routes": [
        {
            "pattern": "firefly.r2d2.to/metadata-v2*",
            "zone_id": "a07cf7abe7b5b21f1a1cf50687bac75a",
        },
    ],
}
