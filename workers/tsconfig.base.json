{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ESNext", "dom"],
        "noEmit": true,
        "paths": {
            "@/*": ["./*"]
        },
        "types": ["@cloudflare/workers-types"]
    }
}
