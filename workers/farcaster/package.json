{
    "name": "@dimensiondev/workers-farcaster",
    "imports": {
        "#/*": "./src/*"
    },
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "wrangler build --config wrangler.jsonc",
        "types": "tsc -p tsconfig.types.json",
        "deploy": "wrangler deploy --config wrangler.jsonc",
        "dev": "wrangler dev --config wrangler.jsonc",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        "./*": "./src/*",
        ".": {
            "types": "./types/index.d.ts",
            "import": "./src/index.ts"
        }
    },
    "dependencies": {
        "@dimensiondev/enums": "workspace:^",
        "@dimensiondev/workers-shared": "workspace:*",
        "@farcaster/core": "^0.18.11",
        "@hono/zod-validator": "^0.7.6",
        "@noble/ed25519": "^1.7.5",
        "@noble/hashes": "^1.7.2",
        "bs58": "^6.0.0",
        "hono": "^4.12.25",
        "viem": "^2.48.11",
        "zod": "^4.0.17"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20251011.0",
        "@types/node": "^24.0.15",
        "wrangler": "^4.45.4"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    }
}
