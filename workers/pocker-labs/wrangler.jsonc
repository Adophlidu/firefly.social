{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "firefly-pocker-labs-worker",
    "main": "./src/index.ts",
    "compatibility_flags": ["nodejs_compat_v2"],
    "compatibility_date": "2024-09-23",
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "be79c0c34fa04bd2bcbb6454876cd054",
        },
    ],
    "routes": [
        {
            "pattern": "firefly.r2d2.to/pocker-labs/*",
            "zone_id": "a07cf7abe7b5b21f1a1cf50687bac75a",
        },
    ],
}
