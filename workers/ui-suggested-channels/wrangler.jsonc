{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "firefly-ui-suggested-channels",
    "main": "./src/index.ts",
    "compatibility_flags": ["nodejs_compat_v2"],
    "compatibility_date": "2024-09-23",
    "kv_namespaces": [
        {
            "binding": "UI_CACHE",
            "id": "b3d471a8921a49cab1578b179fdb21ce",
        },
    ],
    "routes": [
        {
            "pattern": "firefly.r2d2.to/ui/suggested-channels*",
            "zone_id": "a07cf7abe7b5b21f1a1cf50687bac75a",
        },
    ],
}
