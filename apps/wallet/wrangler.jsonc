{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "firefly-wallet",
    "main": "./dist/server/worker.js",
    "compatibility_flags": ["nodejs_compat_v2", "nodejs_compat_populate_process_env"],
    "compatibility_date": "2024-09-23",
    // Deployed to a personal Cloudflare account; served from the workers.dev
    // subdomain until a custom domain (and its zone) is available.
    "workers_dev": true,
    // Optional wagmi/walletconnect connector peers that are not installed;
    // they are only used by client-side connector flows, never during SSR.
    "alias": {
        "@metamask/connect-evm": "./src/shims/optional-connector.ts",
        "porto": "./src/shims/optional-connector.ts",
        "porto/internal": "./src/shims/optional-connector.ts",
        "@walletconnect/ethereum-provider": "./src/shims/optional-connector.ts",
        "ws": "./src/shims/optional-connector.ts",
    },
    "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
    },
    "env": {
        "staging": {
            "name": "firefly-wallet-staging",
            "vars": {
                "NEXT_PUBLIC_BASE_PATH": "/wallet-iframe",
                "NEXT_PUBLIC_VERCEL_ENV": "preview",
            },
        },
        "production": {
            "name": "firefly-wallet",
            "vars": {
                "NEXT_PUBLIC_BASE_PATH": "/wallet-iframe",
                "NEXT_PUBLIC_VERCEL_ENV": "production",
            },
        },
    },
    "observability": {
        "enabled": false,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true,
        },
    },
}
