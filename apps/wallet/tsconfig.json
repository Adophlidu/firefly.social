{
    "extends": "@masknet/config",
    "compilerOptions": {
        "types": [],
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
        "paths": {
            "@/*": ["./src/*"],
            // tamagui v2 ships these two packages' types as raw src .ts (TS2835
            // under NodeNext). Redirect to a permissive stub; the wallet only
            // uses them transitively via tamagui. See tamagui-src-stub.d.ts.
            "@tamagui/element": ["./tamagui-src-stub.d.ts"],
            "@tamagui/use-async": ["./tamagui-src-stub.d.ts"]
        }
    },
    "include": ["globals.d.ts", "src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "src/service-workers"]
}
