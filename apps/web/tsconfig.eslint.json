{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowJs": true
    },
    "include": [
        ".next-config/**/*.ts",
        ".vercel-config/**/*.mjs",
        "globals.d.ts",
        "next-auth.d.ts",
        ".storybook/**/*.ts",
        ".storybook/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "stories/**/*.ts",
        "stories/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "tailwind.config.cjs",
        "postcss.config.cjs",
        "lingui.config.js",
        "next.config.ts",
        "vitest.config.ts",
        "../../packages/**/src/**/*.ts",
        "../../packages/**/src/**/*.tsx",
        "../../packages/**/tsup.config.ts",
        "../../packages/**/vite.config.ts",
        "../../packages/**/vitest.config.ts"
    ],
    "exclude": ["node_modules"]
}
