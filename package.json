{
    "name": "firefly.social",
    "private": true,
    "packageManager": "pnpm@8.15.8",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "start": "turbo start",
        "lint": "turbo lint",
        "test": "turbo test",
        "typecheck": "turbo typecheck",
        "clean": "turbo clean && rm -rf node_modules",
        "lingui": "pnpm -r --filter='./apps/*' run lingui",
        "packages:build": "pnpm -r --filter='./packages/*' run build",
        "packages:dev": "pnpm -r --filter='./packages/*' run dev",
        "packages:typecheck": "pnpm -r --filter='./packages/*' run typecheck",
        "packages:clean": "pnpm -r --filter='./packages/*' run clean",
        "packages:publish": "pnpm -r --filter='./packages/*' publish --no-git-checks"
    },
    "dependencies": {
        "core-js": "3.42.0"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.0.11",
        "@types/node": "22.10.10",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "@typescript-eslint/parser": "^8.47.0",
        "@typescript/lib-dom": "npm:@types/web@^0.0.197",
        "@typescript/native-preview": "7.0.0-dev.20260424.1",
        "cspell": "^7.3.9",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.0.11",
        "eslint-import-resolver-typescript": "^3.10.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-storybook": "^10.0.8",
        "eslint-plugin-tailwindcss": "^3.18.2",
        "eslint-plugin-unicorn": "^62.0.0",
        "eslint-plugin-unused-imports": "^4.3.0",
        "js-yaml": "^4.1.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "turbo": "^2.9.7"
    },
    "pnpm": {
        "resolutionMode": "time-based",
        "overrides": {
            "@noble/curves": "1.9.2",
            "@reown/appkit": "1.8.19",
            "@solana/wallet-adapter-base": "0.9.27",
            "@solana/web3.js": "1.98.4",
            "@tanstack/react-query-next-experimental": "5.85.9",
            "@tanstack/react-query": "5.85.9",
            "@types/node": "22.10.10",
            "@types/react": "^19.2.14",
            "@types/react-dom": "^19.2.3",
            "@walletconnect/logger": "3.0.0",
            "@walletconnect/universal-provider": "2.23.0",
            "core-js-compat": "$core-js",
            "crypto-js@<4.2.0": ">=4.2.0",
            "elliptic": ">=6.6.1",
            "isows": "1.0.7",
            "pino": "10.1.1",
            "react": "19.2.5",
            "react-dom": "19.2.5",
            "react-use": "17.6.0",
            "sha.js": "2.4.12",
            "uint8arrays": "3.1.1",
            "use-sync-external-store": "1.5.0"
        },
        "onlyBuiltDependencies": [],
        "peerDependencyRules": {
            "ignoreMissing": [],
            "allowedVersions": {
                "react": "19.2.5"
            }
        },
        "patchedDependencies": {
            "@lens-protocol/client@0.0.0-canary-20250430134539": "patches/@lens-protocol__client@0.0.0-canary-20250430134539.patch",
            "@lexical/react@0.18.0": "patches/@lexical__react@0.18.0.patch",
            "@reown/appkit@1.8.19": "patches/@reown__appkit@1.8.19.patch",
            "@tippyjs/react@4.2.6": "patches/@tippyjs__react@4.2.6.patch",
            "dayjs-twitter@0.5.0": "patches/dayjs-twitter@0.5.0.patch",
            "eslint-plugin-tailwindcss@3.18.2": "patches/eslint-plugin-tailwindcss@3.18.2.patch",
            "react-use@17.6.0": "patches/react-use@17.6.0.patch",
            "twitter-text@3.1.0": "patches/twitter-text@3.1.0.patch",
            "urlcat@3.1.0": "patches/urlcat@3.1.0.patch",
            "@bprogress/react@1.2.7": "patches/@bprogress__react@1.2.7.patch",
            "@safe-global/safe-apps-sdk@9.1.0": "patches/@safe-global__safe-apps-sdk@9.1.0.patch"
        }
    }
}
