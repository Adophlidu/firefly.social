{
    "name": "firefly.social",
    "private": true,
    "packageManager": "pnpm@8.15.9",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "dev:apps": "turbo dev --filter='./apps/*'",
        "build": "turbo build",
        "start": "turbo start",
        "lint": "turbo lint",
        "test": "turbo test",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test --config=playwright.hermetic.config.ts",
        "typecheck": "turbo typecheck",
        "clean": "turbo clean && rm -rf node_modules",
        "lingui": "pnpm -r --filter='./apps/*' run lingui",
        "packages:build": "pnpm -r --filter='./packages/*' run build",
        "packages:dev": "pnpm -r --filter='./packages/*' run dev",
        "packages:typecheck": "pnpm -r --filter='./packages/*' run typecheck",
        "packages:clean": "pnpm -r --filter='./packages/*' run clean",
        "packages:publish": "pnpm -r --filter='./packages/*' publish --no-git-checks",
        "workers:build": "pnpm -r --filter='./workers/*' run build",
        "workers:typecheck": "pnpm -r --filter='./workers/*' run typecheck",
        "workers:publish": "pnpm -r --filter='./workers/*' run deploy"
    },
    "dependencies": {
        "core-js": "3.49.0"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.2.7",
        "@playwright/test": "^1.60.0",
        "@types/node": "22.19.20",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.61.0",
        "@typescript/lib-dom": "npm:@types/web@^0.0.350",
        "@typescript/native-preview": "7.0.0-dev.20260612.1",
        "cspell": "^7.3.9",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.0.11",
        "eslint-import-resolver-typescript": "^3.10.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-storybook": "^10.4.2",
        "eslint-plugin-tailwindcss": "3.18.2",
        "eslint-plugin-unicorn": "^62.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "js-yaml": "^4.2.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "turbo": "^2.9.16"
    },
    "pnpm": {
        "resolutionMode": "time-based",
        "overrides": {
            "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
            "@noble/curves": "1.9.2",
            "@reown/appkit": "1.8.20",
            "@solana/wallet-adapter-base": "0.9.27",
            "@solana/web3.js": "1.98.4",
            "@tanstack/react-query-next-experimental": "5.85.9",
            "@tanstack/react-query": "5.85.9",
            "@types/node": "22.19.20",
            "@types/react": "^19.2.17",
            "@types/react-dom": "^19.2.3",
            "@walletconnect/logger": "3.0.2",
            "@walletconnect/universal-provider": "2.23.9",
            "axios": ">=1.16.0",
            "bigint-buffer": "npm:four-flap-bigint-buffer@^1.1.6",
            "core-js-compat": "$core-js",
            "crypto-js@<4.2.0": ">=4.2.0",
            "elliptic": ">=6.6.1",
            "fast-uri": ">=3.1.2",
            "fast-xml-parser@>=4.1.3 <4.5.4": "4.5.6",
            "flatted": ">=3.4.2",
            "glob@10": ">=10.5.0",
            "glob@11": ">=11.1.0",
            "h3@1": ">=1.15.6",
            "isows": "1.0.7",
            "js-cookie": ">=3.0.7",
            "lodash": "4.18.1",
            "lodash-es": "4.18.1",
            "picomatch@2": ">=2.3.2",
            "pino": "10.1.1",
            "preact": ">=10.27.3",
            "protobufjs@<7.5.5": "7.5.9",
            "react": "19.2.7",
            "react-dom": "19.2.7",
            "react-use": "17.6.1",
            "serialize-javascript": ">=7.0.3",
            "storybook": ">=10.2.19",
            "sha.js": "2.4.12",
            "svgo@3": ">=3.3.3",
            "typescript": "5.9.3",
            "uint8arrays": "3.1.1",
            "undici": ">=7.24.0",
            "use-sync-external-store": "1.5.0",
            "wrangler": ">=4.59.1"
        },
        "onlyBuiltDependencies": [],
        "peerDependencyRules": {
            "ignoreMissing": [],
            "allowedVersions": {
                "react": "19.2.7"
            }
        },
        "patchedDependencies": {
            "@lens-protocol/client@0.0.0-canary-20250430134539": "patches/@lens-protocol__client@0.0.0-canary-20250430134539.patch",
            "@lexical/react@0.18.0": "patches/@lexical__react@0.18.0.patch",
            "@tippyjs/react@4.2.6": "patches/@tippyjs__react@4.2.6.patch",
            "dayjs-twitter@0.5.0": "patches/dayjs-twitter@0.5.0.patch",
            "eslint-plugin-tailwindcss@3.18.2": "patches/eslint-plugin-tailwindcss@3.18.2.patch",
            "react-use@17.6.1": "patches/react-use@17.6.1.patch",
            "twitter-text@3.1.0": "patches/twitter-text@3.1.0.patch",
            "urlcat@3.1.0": "patches/urlcat@3.1.0.patch",
            "@bprogress/react@1.2.7": "patches/@bprogress__react@1.2.7.patch",
            "@safe-global/safe-apps-sdk@9.1.0": "patches/@safe-global__safe-apps-sdk@9.1.0.patch"
        }
    }
}
