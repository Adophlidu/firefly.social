{
    "name": "firefly.social",
    "private": true,
    "packageManager": "pnpm@11.6.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "dev:apps": "turbo dev --filter='./apps/*'",
        "build": "turbo build",
        "start": "turbo start",
        "lint": "turbo lint",
        "test": "turbo test",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test --config=playwright.hermetic.config.ts",
        "typecheck": "turbo typecheck",
        "clean": "turbo clean && rm -rf node_modules",
        "lingui": "pnpm -r --filter='./apps/*' run lingui",
        "packages:build": "pnpm -r --filter='./packages/*' run build",
        "packages:dev": "pnpm -r --filter='./packages/*' run dev",
        "packages:typecheck": "pnpm -r --filter='./packages/*' run typecheck",
        "packages:clean": "pnpm -r --filter='./packages/*' run clean",
        "packages:publish": "pnpm -r --filter='./packages/*' publish --no-git-checks",
        "workers:build": "pnpm -r --filter='./workers/*' run build",
        "workers:typecheck": "pnpm -r --filter='./workers/*' run typecheck",
        "workers:publish": "pnpm -r --filter='./workers/*' run deploy"
    },
    "dependencies": {
        "core-js": "3.49.0"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.2.7",
        "@playwright/test": "^1.60.0",
        "@types/node": "22.19.20",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.61.0",
        "@typescript/lib-dom": "npm:@types/web@^0.0.350",
        "@typescript/native-preview": "7.0.0-dev.20260612.1",
        "cspell": "^7.3.9",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.0.11",
        "eslint-import-resolver-typescript": "^3.10.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-storybook": "^10.4.2",
        "eslint-plugin-tailwindcss": "3.18.2",
        "eslint-plugin-unicorn": "^62.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "js-yaml": "^4.2.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "turbo": "^2.9.16"
    }
}
