        "build:polyfills": "scripts/build-polyfills.sh",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest",
        "typecheck": "tsc -b .",
        "lingui:compile": "lingui compile",
        "lingui:extract": "NODE_ENV=development lingui extract --clean",
        "lingui": "pnpm run lingui:extract && pnpm run lingui:compile",
        "crowdin:sync": "crowdin push && crowdin pull",
        "crowdin:sync:sources": "crowdin push",
        "crowdin:sync:translations": "crowdin pull",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "packages:build": "pnpm -r --filter='./packages/*' run build",
        "packages:dev": "pnpm -r --filter='./packages/*' run dev",
        "packages:typecheck": "pnpm -r --filter='./packages/*' run typecheck",
        "packages:clean": "pnpm -r --filter='./packages/*' run clean",
