    "scripts": {
        "dev": "next dev --turbo",
        "debug": "NODE_OPTIONS='--inspect' next dev",
        "build": "NODE_OPTIONS=--max_old_space_size=8192 next build",
        "build:statoscope": "NODE_OPTIONS=--max_old_space_size=8192 ANALYZE_STATOSCOPE=true next build --webpack",
        "build:scripts": "node scripts/build-scripts.mjs",
