{
    "name": "@dimensiondev/types",
    "version": "0.1.25",
    "private": true,
    "description": "Shared TypeScript types for Firefly projects",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "types",
        "typescript",
        "firefly"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/types"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "@types/react": ">=18.0.0",
        "react": ">=18.0.0",
        "typescript": ">=5.0.0"
    }
}
