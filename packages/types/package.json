{
    "name": "@dimensiondev/types",
    "version": "0.1.41",
    "private": true,
    "description": "Shared TypeScript types for Firefly projects",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsgo --noEmit",
        "clean": "rm -rf dist"
    },
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/types"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "devDependencies": {
        "@typescript/native-preview": "7.0.0-dev.20260612.1",
        "@types/react": "^19.2.17",
        "tsdown": "^0.21.10"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "typescript": ">=5.0.0"
    }
}
