{
    "name": "@dimensiondev/ssr",
    "imports": {
        "#/*": "./src/*"
    },
    "version": "0.0.0",
    "description": "A minimal universal React SSR framework: file-based routing, streaming SSR, Cloudflare-first",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "require": "./dist/server.cjs"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.cjs"
        },
        "./cloudflare": {
            "types": "./dist/cloudflare.d.ts",
            "import": "./dist/cloudflare.js",
            "require": "./dist/cloudflare.cjs"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js",
            "require": "./dist/vite.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "author": "Firefly Team",
    "license": "MIT",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/react-dom": "19.2.3",
        "jsdom": "^27.4.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "tsdown": "^0.21.10",
        "vite": "^7.3.5",
        "vitest": "^3.2.6"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0",
        "typescript": ">=5.0.0",
        "vite": ">=6.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
