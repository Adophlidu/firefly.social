{
    "name": "@dimensiondev/utils",
    "version": "0.1.29",
    "description": "Shared utility functions for Firefly projects",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsgo --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "utilities",
        "helpers",
        "browser",
        "dom",
        "promise",
        "typescript"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/utils"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "devDependencies": {
        "tsup": "^8.5.1",
        "@typescript/native-preview": "7.0.0-dev.20260413.1"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    }
}
