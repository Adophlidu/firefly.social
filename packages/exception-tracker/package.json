{
    "name": "@dimensiondev/exception-tracker",
    "version": "0.1.13",
    "description": "Exception tracking for Firefly projects",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "exception",
        "tracking",
        "error",
        "firefly"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/exception-tracker"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "dependencies": {
        "@dimensiondev/utils": "workspace:^"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-use": ">=17.0.0"
    },
    "devDependencies": {
        "react": "19.2.3",
        "react-use": "17.6.0",
        "tsup": "^8.5.1",
        "typescript": "5.9.3"
    }
}
