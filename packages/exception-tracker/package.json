{
    "name": "@dimensiondev/exception-tracker",
    "version": "0.1.39",
    "description": "Exception tracking for Firefly projects",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsgo --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "exception",
        "tracking",
        "error",
        "firefly"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/exception-tracker"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "dependencies": {
        "@dimensiondev/utils": "workspace:^",
        "react": "^19.2.6",
        "react-use": "^17.6.0"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-use": ">=17.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "tsdown": "^0.21.10",
        "@typescript/native-preview": "7.0.0-dev.20260508.1"
    }
}
