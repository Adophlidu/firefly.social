{
    "name": "@dimensiondev/web3",
    "version": "0.1.31",
    "description": "Shared Web3 utility functions for Firefly projects",
    "type": "module",
    "main": "./dist/utils.js",
    "module": "./dist/utils.js",
    "types": "./dist/utils.d.ts",
    "exports": {
        "./utils": {
            "types": "./dist/utils.d.ts",
            "import": "./dist/utils.js",
            "require": "./dist/utils.cjs"
        },
        "./constants": {
            "types": "./dist/constants.d.ts",
            "import": "./dist/constants.js",
            "require": "./dist/constants.cjs"
        },
        "./chains": {
            "types": "./dist/chains.d.ts",
            "import": "./dist/chains.js",
            "require": "./dist/chains.cjs"
        },
        "./resolvers": {
            "types": "./dist/resolvers.d.ts",
            "import": "./dist/resolvers.js",
            "require": "./dist/resolvers.cjs"
        },
        "./numbers": {
            "types": "./dist/numbers.d.ts",
            "import": "./dist/numbers.js",
            "require": "./dist/numbers.cjs"
        },
        "./enums": {
            "types": "./dist/enums.d.ts",
            "import": "./dist/enums.js",
            "require": "./dist/enums.cjs"
        },
        "./actions": {
            "types": "./dist/actions.d.ts",
            "import": "./dist/actions.js",
            "require": "./dist/actions.cjs"
        },
        "./abi": {
            "types": "./dist/abi.d.ts",
            "import": "./dist/abi.js",
            "require": "./dist/abi.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "web3",
        "evm",
        "solana",
        "helpers"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/web3"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "devDependencies": {
        "@types/punycode": "^2.1.4",
        "tsdown": "^0.21.10",
        "typescript": "5.9.3",
        "wagmi": "^3.1.4"
    },
    "dependencies": {
        "@coral-xyz/anchor": "^0.31.1",
        "bignumber.js": "9.3.1",
        "punycode": "^2.3.1",
        "urlcat": "^3.1.0",
        "viem": "^2.45.2"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0",
        "wagmi": "^3.1.0"
    }
}
