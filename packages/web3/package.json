{
    "name": "@dimensiondev/web3",
    "version": "0.1.28",
    "description": "Shared Web3 utility functions for Firefly projects",
    "type": "module",
    "main": "./dist/utils.js",
    "module": "./dist/utils.js",
    "types": "./dist/utils.d.ts",
    "exports": {
        "./utils": {
            "types": "./dist/utils.d.ts",
            "import": "./dist/utils.js",
            "require": "./dist/utils.cjs"
        },
        "./constants": {
            "types": "./dist/constants.d.ts",
            "import": "./dist/constants.js",
            "require": "./dist/constants.cjs"
        },
        "./chains": {
            "types": "./dist/chains.d.ts",
            "import": "./dist/chains.js",
            "require": "./dist/chains.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "web3",
        "evm",
        "solana",
        "helpers"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/web3"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "@coral-xyz/anchor": "^0.31.1",
        "bignumber.js": "9.3.1",
        "punycode": "^2.3.1",
        "viem": "^2.45.2"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    }
}
