{
    "name": "@dimensiondev/hooks",
    "version": "0.1.38",
    "description": "Shared React hooks for Firefly projects",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "react",
        "hooks",
        "query",
        "typescript"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/hooks"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "dependencies": {
        "@dimensiondev/utils": "workspace:^",
        "@tanstack/react-query": "5.85.9",
        "lodash-es": "^4.17.23"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.12",
        "@types/react": "19.2.14",
        "tsdown": "^0.21.10",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "typescript": ">=5.0.0"
    }
}
