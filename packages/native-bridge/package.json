{
    "name": "@dimensiondev/native-bridge",
    "version": "0.1.41",
    "description": "Native bridge for Firefly webview integration (Android/iOS)",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/native-bridge"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "dependencies": {
        "@dimensiondev/utils": "workspace:^",
        "@farcaster/miniapp-host": "^0.2.16",
        "lodash-es": "^4.17.23",
        "viem": "^2.48.11"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.12",
        "tsdown": "^0.21.10"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    }
}
