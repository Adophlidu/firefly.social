{
    "name": "@dimensiondev/envs",
    "version": "0.1.40",
    "description": "Environment configuration for Firefly projects",
    "type": "module",
    "exports": {
        "./wallet": {
            "types": "./dist/wallet.d.ts",
            "import": "./dist/wallet.js",
            "require": "./dist/wallet.cjs"
        },
        "./web": {
            "types": "./dist/web.d.ts",
            "import": "./dist/web.js",
            "require": "./dist/web.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsgo --noEmit",
        "clean": "rm -rf dist"
    },
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/envs"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "dependencies": {
        "@dimensiondev/enums": "workspace:^",
        "@dimensiondev/utils": "workspace:^",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@typescript/native-preview": "7.0.0-dev.20260522.1",
        "tsdown": "^0.21.10"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    }
}
