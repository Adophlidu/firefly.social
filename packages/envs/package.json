{
    "name": "@dimensiondev/envs",
    "version": "0.1.18",
    "description": "Environment configuration for Firefly projects",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "env",
        "environment",
        "config",
        "firefly"
    ],
    "author": "Firefly Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/envs"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "dependencies": {
        "@dimensiondev/utils": "workspace:^",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    }
}
