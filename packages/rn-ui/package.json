        "@tamagui/lucide-icons-2": "2.0.0-rc.41",
        "@tanstack/react-query": "5.85.9",
        "bignumber.js": "9.3.1",
        "jotai": "^2.19.1",
        "jotai-effect": "^2.2.3",
        "lucide-react-native": "^0.473.0",
        "react-native-svg": "^15.15.4",
        "tamagui": "^1.114.0",
        "urlcat": "^3.1.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-native": "^0.73.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@typescript/native-preview": "7.0.0-dev.20260417.1",
