{
    "name": "@dimensiondev/rn-ui",
    "version": "0.1.31",
    "description": "React Native UI components for Firefly",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
