{
    "name": "@dimensiondev/rn-ui",
    "version": "0.1.40",
    "description": "React Native UI components for Firefly",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./dist/index.js",
    "files": [
        "dist",
        "src",
        "!src/locales/**/*.po",
        "!src/**/__tests__/**",
        "!src/**/*.test.*",
        "!scripts/**"
    ],
    "exports": {
        ".": {
            "react-native": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./provider": {
            "react-native": "./dist/entries/provider.js",
            "types": "./dist/provider.d.ts",
            "import": "./dist/provider.js",
            "require": "./dist/provider.cjs"
        },
        "./perps": {
            "react-native": "./dist/entries/perps.js",
            "types": "./dist/perps.d.ts",
            "import": "./dist/perps.js",
            "require": "./dist/perps.cjs"
        },
        "./tamagui.config": "./src/tamagui.config.ts"
    },
    "scripts": {
        "build": "vite build",
        "build:analyze": "ANALYZE=1 vite build",
        "dev": "vite build --watch",
        "lingui:compile": "lingui compile",
        "lingui:extract": "NODE_ENV=development lingui extract --clean",
        "extract": "lingui extract",
        "extract:check": "lingui extract && git diff --exit-code src/locales/en/messages.po",
        "lint": "eslint src",
        "test": "vitest run",
        "typecheck": "tsgo --noEmit"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DimensionDev/firefly.mask.social",
        "directory": "packages/rn-ui"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "peerDependencies": {
        "@dimensiondev/constants": "^0.1.40",
        "@dimensiondev/utils": "^0.1.31",
        "@lingui/core": "^5.9.5",
        "@lingui/react": "^5.9.5",
        "@nktkas/hyperliquid": "^0.32.2",
        "@tamagui/config": "^1.114.0",
        "@tamagui/core": "^1.114.0",
        "@tamagui/helpers": "^1.114.0",
        "@tamagui/lucide-icons-2": "2.0.0-rc.41",
        "@tanstack/react-query": "^5.85.9",
        "bignumber.js": "^9.3.1",
        "jotai": "^2.19.1",
        "jotai-effect": "^2.2.3",
        "jotai-tanstack-query": "^0.11.0",
        "lucide-react-native": "^0.473.0",
        "react": "*",
        "react-native": "*",
        "react-native-svg": "*",
        "react-native-webview": "*",
        "tamagui": "^1.114.0",
        "urlcat": "^3.1.0"
    },
    "peerDependenciesMeta": {
        "react-native-webview": {
            "optional": true
        }
    },
    "devDependencies": {
        "@dimensiondev/constants": "workspace:^",
        "@dimensiondev/utils": "workspace:^",
        "@lingui/babel-plugin-lingui-macro": "^5.9.5",
        "@lingui/cli": "^5.9.5",
        "@lingui/conf": "^5.9.5",
        "@lingui/core": "^5.9.5",
        "@lingui/format-po-gettext": "^5.9.5",
        "@lingui/react": "^5.9.5",
        "@lingui/vite-plugin": "^5.9.5",
        "@nktkas/hyperliquid": "^0.32.2",
        "@tamagui/config": "^1.114.4",
        "@tamagui/core": "^1.114.4",
        "@tamagui/helpers": "1.114.4",
        "@tamagui/lucide-icons-2": "2.0.0-rc.41",
        "@tanstack/react-query": "5.85.9",
        "@types/react": "^19.2.15",
        "@types/react-native": "^0.73.0",
        "@typescript/native-preview": "7.0.0-dev.20260522.1",
        "@vitejs/plugin-react": "^4.7.0",
        "bignumber.js": "9.3.1",
        "jotai": "^2.19.1",
        "jotai-effect": "^2.2.3",
        "jotai-tanstack-query": "^0.11.0",
        "lucide-react-native": "^0.473.0",
        "react-native-svg": "^15.15.5",
        "react-native-webview": "^13.0.0",
        "rollup-plugin-visualizer": "^7.0.1",
        "tamagui": "^1.114.4",
        "urlcat": "^3.1.0",
        "vite": "^7.3.3",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    }
}
