    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*",
        "react-native-svg": "*"
    },
    "dependencies": {
        "@dimensiondev/utils": "workspace:^",
        "@nktkas/hyperliquid": "^0.32.2",
        "@tamagui/config": "^1.114.0",
